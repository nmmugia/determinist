# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangSmith Configuration (optional - for LLM tracing)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=transaction-investigation

# Database Configuration (default values for local development)
POSTGRES_DB=transaction_investigation
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpass
DATABASE_URL=postgresql://dbuser:dbpass@postgres:5432/transaction_investigation?sslmode=disable

# Service Ports
GO_API_PORT=8080
PYTHON_AI_PORT=8000
JAEGER_UI_PORT=16686
